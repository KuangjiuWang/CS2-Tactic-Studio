# Read by the Electron main process only. These values are never injected into the renderer bundle.
# The Supabase anon key is a public client key, not a service-role secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional hosted web viewer base URL. If omitted, links download the .cstactic package.
VITE_SHARE_VIEWER_URL=
