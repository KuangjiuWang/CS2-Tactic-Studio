{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CS2 Tactic Studio",
  "version": "0.1.4",
  "identifier": "local.cs2tacticstudio.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CS2 Tactic Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": ["../../packaging/windows/app-icon.ico"],
    "resources": {
      "bundle-resources/": ""
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "../../packaging/windows/app-icon.ico",
        "installerHooks": "./windows/upgrade-hooks.nsh",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
